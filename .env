# Copier en `.env` et adapter. Variables inlinées au bundling (préfixe EXPO_PUBLIC_).

# Racine du backend Symfony/API Platform (sans /api).
# 10.0.2.2 = hôte local vu depuis l'émulateur Android ; appareil physique = IP LAN.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000

# Slug de la compagnie (champ entreprise.slug côté backend) — périmètre ?slug=.
EXPO_PUBLIC_COMPANY_SLUG=ira-transport
